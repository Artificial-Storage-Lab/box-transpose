% Bibliography for the box transpose paper. Style is plain.bst, matching the
% smartcontiguous paper. Add real entries here and \cite them from main.tex.
%
% Left deliberately empty of real citations rather than pre-filled with
% half-remembered metadata — wrong author lists and page numbers are harder to
% notice than missing ones. The entry below is a syntax template; delete it.

@misc{template-entry,
  author       = {Lastname, Firstname},
  title        = {Title of the Work},
  howpublished = {Venue or URL},
  year         = {2026},
}
